<!doctype html>
<html lang="pt" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eco-Time</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;700&display=swap" rel="stylesheet">
    <style>
      .texto-pixelado {
        font-family: 'Pixelify Sans', sans-serif;
        font-size: 100px;
      }
      .texto-pixelado2 {
        font-family: 'Pixelify Sans', sans-serif;
        font-size: 45px;
      }
      .retangulos {
        background-color: burlywood;
        padding: 10px;
        border-radius: 8px 8px 0 0;
        color: #000;
      }
      .retangulos2 {
        background-color: darkolivegreen;
      }
      .card-bg-custom {
        background-color: hsla(258, 57%, 29%, 0.253);
      }
      .bg-verde-container {
        background-color: rgb(27, 109, 6);
      }
    </style>
  </head>
  <body class="bg-dark text-white">
    
    <main class="container-fluid p-3">
      
      <div 
  class="position-relative overflow-hidden p-3 p-md-5 m-md-3 text-center"
  style="background-color: darkolivegreen;"
>
        <div class="col-md-6 p-lg-5 mx-auto my-5"
        style="background-color: cornflowerblue;">
          <h1 style="color: rgb(27, 112, 6);" class="texto-pixelado">Eco-Time</h1>
          <h3 class="fw-normal text-muted mb-3">Build anything you want with Aperture</h3>
        </div>
      </div>
      <div class="row g-3 my-3 bg-verde-container p-3 rounded mx-1">
        <div class="col-md-6">
          <div class="card-bg-custom p-3 text-center rounded">
            <div class="retangulos">
              <h2 class="texto-pixelado2">Gameplay</h2>
              <p class="lead mb-0">Um pouco do nosso jogo.</p>
            </div>
            <div class="retangulos2 mx-auto" style="width: 80%; height: 350px; border-radius: 21px 21px 0 0;"></div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card-bg-custom p-3 text-center rounded">
            <div class="retangulos">
              <h2 class="texto-pixelado2">Sem ideias</h2>
              <p class="lead mb-0">And an even wittier subheading.</p>
            </div>
            <div class="bg-dark mx-auto" style="width: 80%; height: 350px; border-radius: 21px 21px 0 0;"></div>
          </div>
        </div>
      </div>

     
      <div class="row g-3 my-3 bg-verde-container p-3 rounded mx-1">
        
      
        <div class="col-md-6">
          <div class="card-bg-custom p-3 text-center rounded h-100 d-flex flex-column justify-content-between">
            <div class="retangulos">
              <h2 class="texto-pixelado2">Storyboards</h2>
              <p class="lead mb-0">Tudo desde o começo.</p>
            </div>
            <div class="bg-dark mx-auto w-100 mt-3" style="height: 480px; border-radius: 21px 21px 0 0;"></div>
          </div>
        </div>

       
        <div class="col-md-6">
          <div class="p-3 border border-primary border-4 rounded bg-dark h-100">
            <div class="row g-3">
              
              <div class="col-6">
                <div class="card-bg-custom p-2 text-center rounded">
                  <div class="retangulos">
                    <h3 class="texto-pixelado2 fs-4 mb-0">Sinopse</h3>
                    <small>Contexto do jogo</small>
                  </div>
                  <div class="bg-secondary mx-auto mt-2" style="width: 90%; height: 160px; border-radius: 12px 12px 0 0;"></div>
                </div>
              </div>

              <div class="col-6">
                <div class="card-bg-custom p-2 text-center rounded">
                  <div class="retangulos">
                    <h3 class="texto-pixelado2 fs-4 mb-0">Github</h3>
                    <small>Repositório</small>
                  </div>
                  <div class="bg-secondary mx-auto mt-2" style="width: 90%; height: 160px; border-radius: 12px 12px 0 0;"></div>
                </div>
              </div>

              <div class="col-6">
                <div class="card-bg-custom p-2 text-center rounded">
                  <div class="retangulos">
                    <h3 class="texto-pixelado2 fs-4 mb-0">Cenários</h3>
                    <small>Sprites e mapas</small>
                  </div>
                  <div class="bg-secondary mx-auto mt-2" style="width: 90%; height: 160px; border-radius: 12px 12px 0 0;"></div>
                </div>
              </div>

              <div class="col-6">
                <div class="card-bg-custom p-2 text-center rounded">
                  <div class="retangulos">
                    <h3 class="texto-pixelado2 fs-4 mb-0">Equipe</h3>
                    <small>Membros</small>
                  </div>
                  <div class="bg-secondary mx-auto mt-2" style="width: 90%; height: 160px; border-radius: 12px 12px 0 0;"></div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
